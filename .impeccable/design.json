  "narrative": {
    "northStar": "A Sala Silenciosa",
    "overview": "O CRM é uma sala de tratamento de noite: baixa, quente, sem ruído. A interface desaparece e fica a tarefa da Bea, que usa o iPad entre sessões. O escuro é o padrão, com midnight e osso e o champanhe velado como único metal; o modo claro em papel é uma escolha da utilizadora.",
    "keyCharacteristics": [
      "Um só metal: o champanhe velado, raro e nunca decorativo.",
      "Cantos quase rectos (2px) e fios finos em vez de sombras pesadas.",
      "Títulos e números em serifa (DM Serif Display); tudo o resto em Manrope.",
      "Movimento de feedback e continuidade; nunca coreografia de carregamento.",
      "Escuro por omissão, claro (paper) por escolha, ambos com os mesmos tokens semânticos."
    ],
    "rules": [
      {
        "name": "A Regra do Metal Único",
        "body": "O champanhe velado aparece em poucos elementos por ecrã (acção principal, item activo, foco). A raridade é a marca.",
        "section": "colors"
      },
      {
        "name": "A Regra do Fumo",
        "body": "O smoke (#7a7e8a) só serve texto a partir de 18px (ou 14px com peso 600). Texto pequeno usa bone-soft.",
        "section": "colors"
      },
      {
        "name": "A Regra do Peso Fixo",
        "body": "O peso da letra nunca muda com o estado activo; a distinção faz-se pela cor.",
        "section": "typography"
      },
      {
        "name": "A Regra da Sombra Funda",
        "body": "As sombras são profundas e neutras, nunca coloridas.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar o champanhe velado só para a acção principal, o item activo e o foco.",
      "Do dar aos alvos de toque das acções frequentes pelo menos 44px.",
      "Do ligar todo o texto pequeno a bone-soft (ou bone); o smoke só a partir de 18px.",
      "Do manter o peso da letra fixo entre estados e mudar só a cor.",
      "Do usar os mesmos nomes de token nos dois modos e trocar só os valores.",
      "Do dar sempre uma alternativa de movimento reduzido: cor, opacidade e estado ficam, o deslocamento sai."
    ],
    "donts": [
      "Don't usar gradientes, brilhos ou efeitos que evoquem tecnologia ou neon.",
      "Don't usar branco frio, ícones médicos ou qualquer tom de consultório.",
      "Don't deixar animação ou cor competir com a tarefa.",
      "Don't usar border-left colorido grosso, nem cartões dentro de cartões.",
      "Don't introduzir sombras coloridas novas nem sombras duras deslocadas.",
      "Don't usar a palavra \"você\" nem tom corporativo em texto de interface."
    ]
  }
}