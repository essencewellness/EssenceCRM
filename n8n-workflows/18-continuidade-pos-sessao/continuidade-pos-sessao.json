        "jsCode": "const candidatos = $('Buscar Candidatos Continuidade').item.json.data || [];\nconst pendentes = $('Buscar Mensagens Pendentes').item.json.data || [];\nconst idsComPendente = new Set(pendentes.map(m => m.clienteId));\nconst LIMITE_DIARIO = 10;\nreturn candidatos.filter(c => !idsComPendente.has(c.id)).slice(0, LIMITE_DIARIO).map(c => ({ json: { clienteId: c.id } }));"
