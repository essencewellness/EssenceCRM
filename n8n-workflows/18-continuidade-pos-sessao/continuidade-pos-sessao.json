        "jsCode": "const prep = $('Preparar Prompt Continuidade').item.json;\nconst raw = ($json.content && $json.content[0] && $json.content[0].text) || '';\nlet mensagem = '';\nlet motivo = 'Check-in de continuidade';\ntry {\n  const clean = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  const d = clean ? JSON.parse(clean) : {};\n  mensagem = (d.mensagem || '').trim();\n  motivo = (d.motivo || motivo).slice(0, 300);\n} catch (e) { /* JSON invalido -- falhou abaixo */ }\n\n// Rede de seguranca -- nunca deixar passar sugestao de marcacao/venda\nconst PADROES_PROIBIDOS = [/marcar/i, /agendar/i, /pack/i, /desconto/i, /pre[cÃ§]o/i];\nconst violacao = PADROES_PROIBIDOS.some(re => re.test(mensagem));\n\nreturn [{ json: { clienteId: prep.clienteId, mensagemGerada: mensagem, motivoGeracao: motivo, falhou: !mensagem || violacao } }];"
      },
