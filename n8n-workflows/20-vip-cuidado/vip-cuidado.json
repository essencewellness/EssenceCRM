    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {model: 'claude-haiku-4-5', max_tokens: 400, system: $json.systemPrompt, messages: [{role: 'user', content: $json.userPrompt}]} }}",
        "options": {}
      },
      "id": "http-claude",
      "name": "Claude Haiku — Gerar Mensagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "anthropicApi": {
          "id": "FWjIgyoGZXTkUQ3n",
          "name": "Anthropic account"
        }
      },
      "position": [
        100,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Preparar Prompt').item.json;\nconst raw = ($json.content && $json.content[0] && $json.content[0].text) || '';\nlet mensagem = '';\nlet motivo = 'Sem motivo';\ntry {\n  const clean = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  const d = clean ? JSON.parse(clean) : {};\n  mensagem = (d.mensagem || '').trim();\n  motivo = (d.motivo || motivo).slice(0, 300);\n} catch (e) { /* falhou abaixo */ }\nconst PADROES_PROIBIDOS = [\n  /combin(a|amos|ar|ados?|\\u00e1mos)\\b/i,\n  /vamos marcar/i,\n  /deixe-me confirmar/i,\n];\nconst violacao = PADROES_PROIBIDOS.some(re => re.test(mensagem));\nreturn [{ json: { clienteId: prep.clienteId, mensagemGerada: mensagem, motivoGeracao: motivo, falhou: !mensagem || violacao } }];"
      },
      "id": "code-parse",
      "name": "Parsear Mensagem Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.falhou }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
