    {
      "parameters": {
        "method": "POST",
        "url": "https://evolution.essencewellnesspt.com/chat/findMessages/essence_whatsapp",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "apikey", "value": "{{EVOLUTION_API_KEY}}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (function(){ const props = $('Obter Perfil Completo').item.json.properties || {}; const phoneVal = props.phone ? (props.phone.value || '') : ''; const mobileVal = props.mobilephone ? (props.mobilephone.value || '') : ''; const raw = (phoneVal || mobileVal).replace(/[^0-9]/g, ''); const jid = (raw.startsWith('351') ? raw : '351' + raw) + '@s.whatsapp.net'; return JSON.stringify({ where: { key: { remoteJid: jid } }, limit: 100 }); })()} }}",
        "options": {}
      },
      "id": "node-wa-messages",
      "name": "Obter Mensagens WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
