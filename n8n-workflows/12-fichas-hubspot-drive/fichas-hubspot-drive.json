      "name": "Ler Clientes Processados",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [-640, 304],
      "alwaysOutputData": true,
      "credentials": { "googleSheetsOAuth2Api": { "id": "GCTW58m5CujREAuw", "name": "Google Sheets account" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": { "jsCode": "const contact = $('Loop por Contacto').item.json;\nconst vid = String(contact.vid || contact.id || '');\nconst processados = $('Ler Clientes Processados').all().map(item => String(item.json.vid || ''));\nconst isNew = !processados.includes(vid);\nreturn [{ json: { ...contact, isNew } }];" },
      "id": "node-check-new",
      "name": "Checar se Cliente é Novo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [256, 368],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" },
