    {
      "parameters": { "url": "=https://api.hubapi.com/contacts/v1/contact/vid/{{ $json.vid || $json.id }}/profile", "authentication": "predefinedCredentialType", "nodeCredentialType": "hubspotAppToken", "options": {} },
      "id": "node-get-profile",
