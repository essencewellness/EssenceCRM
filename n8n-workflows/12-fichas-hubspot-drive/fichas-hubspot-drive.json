    {
      "parameters": { "jsCode": "// Constrói o markdown da ficha do cliente a partir de HubSpot + WhatsApp +\n// resumo Groq. Ver node original no N8N para o gerador completo (tabelas de\n// info de contacto, deals, histórico de interações, conversa WhatsApp).\nconst contact = $('Obter Perfil Completo').item.json;\nconst props = contact.properties || {};\nconst getProp = (key) => { const val = props[key]; if (val === null || val === undefined || val === '') return 'N/A'; if (typeof val === 'object') return val.value || val.label || String(Object.values(val)[0] || 'N/A'); return String(val); };\nconst nome = (getProp('firstname') + ' ' + getProp('lastname')).replace(/\\bN\\/A\\b/g, '').trim() || 'Sem Nome';\nconst telefone = getProp('phone') !== 'N/A' ? getProp('phone') : (getProp('mobilephone') !== 'N/A' ? getProp('mobilephone') : '');\nconst filename = nome + (telefone ? ' ' + telefone : '') + '.md';\nreturn { json: { contactId: contact.id || contact.vid, nomeCliente: nome, filename, markdown: '# Ficha de Cliente: ' + nome + '\\n\\n(gerador completo no N8N)', folderId: '1CXjo7rwV0QWY8kTUsKFHjnkE-aZVFBDF' } };" },
      "id": "node-build-md",
      "name": "Construir Ficha Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 304],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "createFromText",
        "content": "={{ $json.markdown }}",
        "name": "={{ $json.filename }}",
        "driveId": { "__rl": true, "mode": "list", "value": "My Drive", "cachedResultName": "My Drive" },
        "folderId": { "mode": "id", "value": "={{ $json.folderId }}" },
        "options": {}
      },
