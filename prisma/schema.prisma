generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Autenticação (NextAuth) ───────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  username             String?   @unique
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 String    @default("terapeuta")
  precisaMudarPassword Boolean   @default(false)
  ativo                Boolean   @default(true)
  // "baixo" | "medio" | "alto" — escala visual aplicada a todo o dashboard
  // (zoom, não só font-size). "baixo" já é maior que o tamanho antigo por
  // omissão — pedido directo da Bea a usar o CRM no iPad o dia todo.
  preferenciaFonte     String    @default("baixo")
  accounts             Account[]
  sessions             Session[]
  sessoesRealizadas    Sessao[]  @relation("TerapeutaSessao")
  sessoesComoSegunda   Sessao[]  @relation("Terapeuta2Sessao")
  vouchersAtribuidos   GiftCard[] @relation("TerapeutaGiftCard")
  vouchersComoSegunda  GiftCard[] @relation("Terapeuta2GiftCard")
  packsAtribuidos      Pack[]     @relation("TerapeutaPack")
  clientesPrincipais   Cliente[] @relation("TerapeutaCliente")
  tarefasCriadas       Tarefa[]  @relation("TarefaCriada")
  tarefasAtribuidas    Tarefa[]  @relation("TarefaAtribuida")
  createdAt            DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Enums (integridade ao nível da base de dados) ─────────────

enum EstadoTarefa {
  pendente
  em_progresso
  concluida
  cancelada
}

enum PrioridadeTarefa {
  baixa
  normal
  alta
  urgente
}

enum TipoTarefa {
  follow_up
  ligacao
  mensagem
  nota
  outro
}

enum EstadoPagamento {
  pendente
  pago
  parcial
  isento
}

enum MetodoPagamento {
  dinheiro
  mbway            // legado — mantido só para não invalidar registos antigos
  mbway_essence    // conta MBWay "Essence Wellness" (é da Bea, mas de uso do negócio)
  mbway_beatriz    // conta MBWay pessoal da Bea
  transferencia
  stripe
  voucher
}

enum EstadoCampanha {
  ativa
  cancelada
  concluida
}

enum TipoEtiqueta {
  saude
  campanha
  preferencia
  automatica
}

enum EstadoCliente {
  lead
  novo
  ativa_recente
  ativa_frequente
  vip_embaixadora
  vip_em_risco
  reativacao
  perdida
  blacklist
}

enum EstadoSessao {
  agendada
  confirmada
  aguarda_terapeuta
  realizada
  cancelada
  falta
}

enum EstadoMensagem {
  pendente
  aprovada
  em_fila
  enviada
  rejeitada
  falhada
}

enum Canal {
  whatsapp
  email
  sms
}

// ── CRM Principal ─────────────────────────────────────────────

model Cliente {
  id          String    @id @default(cuid())
  nome        String
  telefone    String?   @unique
  email       String?   @unique

  // Dados pessoais
  dataNascimento      DateTime?
  comoNosConheceu     String?   // instagram, referencia, google, calendly, etc.
  fonte               String    @default("calendly")

  // Estado CRM (9 estados)
  estado              EstadoCliente @default(novo)

  // Terapeuta responsável pelo cliente (atribuição mutável — base do isolamento por terapeuta)
  terapeutaPrincipalId String?
  terapeutaPrincipal   User?   @relation("TerapeutaCliente", fields: [terapeutaPrincipalId], references: [id], onDelete: SetNull)

  // Histórico clínico — DADOS DE SAÚDE (RGPD Art. 9: categoria especial)
  historicoAromasPreferidos     String?
  historicoCondicoesAlergias    String?
  historicoEstadoEmocional      String?   // deprecated: passa a ficar na Sessao
  historicoZonasTensao          String?   // deprecated: passa a ficar na Sessao
  historicoUltimaPausa          String?
  notasPessoais                 String?   // deprecated: passa a ficar na Sessao

  // Ficha clínica acumulativa gerada por IA (atualizada a cada onboarding)
  fichaClinica                  String?

  // Preferências de contacto
  canalPreferido      Canal     @default(whatsapp)
  temWhatsapp         Boolean   @default(true)
  aceitaMarketing     Boolean   @default(true)
  melhorDiaContacto   String?

  // RGPD — consentimentos com timestamp (prova de consentimento)
  consentimentoMarketingEm  DateTime?
  consentimentoSaudeEm      DateTime?   // consentimento explícito para dados clínicos
  anonimizadoEm             DateTime?   // preenchido quando exerce direito ao apagamento

  // Soft delete — nunca destruir histórico clínico por acidente
  apagadoEm           DateTime?

  // Métricas calculadas (actualizadas pelo motor de estados / sessões)
  ultimaSessao        DateTime?
  totalSessoes        Int       @default(0)
  totalGasto          Decimal   @default(0) @db.Decimal(10, 2)

  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  sessoes             Sessao[]
  etiquetas           ClienteEtiqueta[]
  mensagens           MensagemIA[]
  observacoes         Observacao[]
  precos              PrecoPersonalizado[]
  packs               Pack[]
  portalToken         PortalToken?
  giftCards           GiftCard[] @relation("BeneficiarioGiftCard")
  vouchersComprados   GiftCard[] @relation("CompradorGiftCard")
  tarefas             Tarefa[]
  feedbacks           Feedback[]
  linkTokens          LinkToken[]

  @@index([estado])
  @@index([apagadoEm])
  @@index([terapeutaPrincipalId])
}

model Sessao {
  id          String    @id @default(cuid())
  clienteId   String

  data        DateTime
  hora        String?
  duracao     Int?      // duração em minutos
  servico     String?
  preco       Decimal?  @db.Decimal(10, 2)
  // Nome livre da terapeuta, só para exibição — null enquanto ninguém foi
  // atribuída (a Bea ainda não respondeu "quem vai realizar a sessão?").
  // Nunca usar isto para saber de quem é a receita — isso é terapeutaId
  // (FK), onde null SIM significa "da Bea por omissão" (convenção diferente
  // e intencional, usada no financeiro/vouchers/repasse).
  terapeuta   String?

  // Conteúdo clínico (preenchido pela Bea no form pós-sessão)
  aromaSessao         String?
  estadoEmocional     String?
  resumoSessao        String?
  notasPosSessao      String?
  linkDocumento       String?

  // Ficha de onboarding desta sessão (preenchida pela cliente antes da sessão)
  fichaEstadoEmocional    String?
  fichaZonasTensao        String?
  fichaFoco               String?
  fichaCondicoesAlergias  String?
  fichaAromasPreferidos   String?

  // Formulários públicos de uso único (WhatsApp): preenchido quando o envio
  // é aceite pela primeira vez. Um segundo GET com este campo já preenchido
  // mostra "já enviaste" em vez do formulário; um segundo POST não regrava —
  // devolve sucesso na mesma sem tocar nos dados (retry de rede não pode
  // ficar sem saída, mas também não pode substituir o que já foi enviado).
  // Campo dedicado e não terapeutaId/estado: esses podem ser alterados por
  // outras vias (dashboard, N8N) sem que ninguém tenha passado por este
  // formulário — usá-los como sinal de "já submetido por aqui" bloquearia
  // o formulário por um motivo que não tem nada a ver com ele.
  onboardingSubmetidoEm   DateTime?
  atribuicaoSubmetidaEm   DateTime?
  // pos-sessao e confirmar-sessao são a exceção: os únicos escritores
  // possíveis de "estado = realizada" / "confirmacaoPresenca" são,
  // respetivamente, estes dois formulários (mais o dashboard, que já é
  // autenticado e fora do âmbito de "uso único" de um link WhatsApp) — por
  // isso reutilizam esses campos em vez de duplicar mais um.

  // Terapeuta que realizou a sessão
  terapeutaId  String?
  user         User?    @relation("TerapeutaSessao", fields: [terapeutaId], references: [id])

  // Segunda terapeuta — só nas massagens a dois, em que as duas trabalham
  // ao mesmo tempo na mesma marcação. Null em todas as outras sessões.
  terapeuta2Id String?
  user2        User?    @relation("Terapeuta2Sessao", fields: [terapeuta2Id], references: [id])

  estado              EstadoSessao @default(agendada)

  dataRecomendadaRegresso DateTime?

  // Rastreio de comunicações automáticas (escrito pelos Workflows N8N)
  briefingEnviado      Boolean   @default(false)
  lembreteEnviado      Boolean   @default(false)
  confirmacaoPresenca  Boolean?
  // Os 3 flags nutricao* rastreiam os 3 toques do fluxo de nutrição pré-sessão:
  // boas-vindas (+2d após marcação), meio do caminho (14d antes), reta final (7d antes)
  nutricaoBoasVindasEnviado Boolean @default(false)
  nutricao14dEnviado   Boolean   @default(false)
  nutricao7dEnviado    Boolean   @default(false)
  googleDocLink        String?
  // Lembrete à terapeuta para registar a sessão — enviado logo após o fim
  // do tratamento (data + hora + duração + 10 min), não num lote diário
  lembretePosSessaoEnviado Boolean @default(false)

  // Ficha de sessão para a terapeuta — relatório clínico estruturado (Groq), gerado 24h antes
  briefingJson         Json?

  // Catálogo de serviços (FK opcional — retrocompatível com sessões antigas)
  servicoId        String?
  // Pack a que esta sessão pertence, se a marcação veio de um link de pack
  // (?utm_content=<packId> no Calendly — ver PacksTab.tsx e o webhook do
  // Calendly). Ao ligar aqui, o webhook incrementa Pack.sessoesUsadas — é
  // assim que se sabe "quantas das 10 já foram feitas".
  packId           String?
  pack             Pack?    @relation(fields: [packId], references: [id])
  // Idempotência Calendly — UUID único do evento, impede sessões duplicadas
  calendlyEventId  String? @unique

  // Pagamento
  estadoPagamento  EstadoPagamento  @default(pendente)
  valorPago        Decimal?         @db.Decimal(10, 2)
  metodoPagamento  MetodoPagamento?
  pagamentoEm      DateTime?
  // Repasse — só há um MBWay físico (é da Bea); quando é a Cristina que
  // recebe por lá, o dinheiro fica na conta da Bea até ela entregar a
  // parte da Cristina em mão. Isto rastreia essa dívida interna.
  repasseNecessario Boolean   @default(false)
  repasseFeito      Boolean   @default(false)
  repasseFeitoEm    DateTime?
  // Quanto do valorPago pertence à Cristina. Null = o valor todo (o caso
  // normal: sessão feita só por ela). Numa massagem a dois é metade, porque
  // as duas trabalharam a mesma marcação.
  valorRepasse      Decimal?  @db.Decimal(10, 2)

  // Sugestão de etiquetas por IA (Groq) — marca quando esta sessão já foi
  // lida pelo workflow N8N, para nunca reprocessar a mesma sessão duas vezes
  etiquetasSugeridasEm DateTime?

  // Avaliação pós-sessão
  avaliacaoNota         Int?
  avaliacaoComentario   String?
  avaliacaoEnviadaEm    DateTime?
  avaliacaoRespondidaEm DateTime?

  // Integrações
  calendarEventId  String?
  pdfUrl           String?
  calendlyEventUri String?
  // Links nativos do Calendly para remarcar/cancelar — usados na página pública
  // de confirmação em vez de reinventarmos essa lógica
  calendlyRescheduleUrl String?
  calendlyCancelUrl     String?

  apagadoEm   DateTime?
  criadoEm    DateTime  @default(now())

  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico_rel Servico?  @relation(fields: [servicoId], references: [id])
  feedbacks   Feedback[]
  linkTokens  LinkToken[]

  @@index([data])
  @@index([clienteId])
  @@index([estado])
  @@index([servicoId])
  @@index([packId])
  @@index([estadoPagamento])
  @@index([terapeutaId])
  @@index([terapeuta2Id])
  @@index([calendlyEventUri])
}

// Token curto e opaco para os links públicos enviados por WhatsApp (ficha-sessao,
// pos-sessao, atribuir-sessao, confirmar-sessao, onboarding, feedback). Liga-se
// a uma Sessao (caso ideal — mais preciso) ou a um Cliente (quando ainda não há
// sessão marcada, ex.: onboarding de um lead antes de reservar). Exatamente um
// dos dois deve estar preenchido.
model LinkToken {
  id        String   @id @default(cuid())
  codigo    String   @unique
  sessaoId  String?
  clienteId String?
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  sessao    Sessao?  @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([sessaoId])
  @@index([clienteId])
  @@index([expiraEm])
}

model Etiqueta {
  id                 String            @id @default(cuid())
  nome               String            @unique
  cor                String            @default("#b9a07a")
  tipo               TipoEtiqueta      @default(campanha)
  bloqueiaAutomacoes Boolean           @default(false)
  clientes           ClienteEtiqueta[]

  @@index([tipo])
  @@index([bloqueiaAutomacoes])
}

model ClienteEtiqueta {
  clienteId  String
  etiquetaId String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([clienteId, etiquetaId])
  @@index([etiquetaId])
}

model Observacao {
  id        String   @id @default(cuid())
  clienteId String
  texto     String
  autor     String   @default("bea")
  criadoEm DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model MensagemIA {
  id               String    @id @default(cuid())
  clienteId        String
  canal            Canal     @default(whatsapp)
  mensagemGerada   String
  mensagemFinal    String?
  estado           EstadoMensagem @default(pendente)
  // pendente → aprovada → em_fila → enviada | rejeitada | falhada
  motivoGeracao    String?
  converteu        Boolean?
  geradaEm         DateTime  @default(now())
  aprovadaEm       DateTime?
  enviadaEm        DateTime?

  // Fila de envio com espaçamento anti-spam (30–90s entre mensagens)
  enviarApos       DateTime?
  erroEnvio        String?

  // Tipo de mensagem e associação a campanha
  tipo             String    @default("reengagement")
  campanhaId       String?

  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  campanha         Campanha? @relation(fields: [campanhaId], references: [id])

  @@index([estado])
  @@index([clienteId])
  @@index([enviarApos])
  @@index([campanhaId])
}

// ── Catálogo de Serviços ──────────────────────────────────────

model Servico {
  id             String   @id @default(cuid())
  nome           String   @unique
  // Nota interna do catálogo (campo "Breve descrição" em /servicos).
  descricao      String?
  // Texto que aparece no voucher que a cliente recebe. Registo diferente da
  // `descricao`: é escrito para ela ("Recebeste uma..."), não para o
  // catálogo. Separado de propósito — quem edita um não quer mexer no outro.
  descricaoVoucher String?
  duracaoMinutos Int      @default(60)
  precoBase      Decimal  @db.Decimal(10, 2)
  ativo          Boolean  @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessoes Sessao[]
  precos  PrecoPersonalizado[]
  packs   Pack[]

  @@index([ativo])
}

model PrecoPersonalizado {
  id        String    @id @default(cuid())
  clienteId String
  servicoId String
  valor     Decimal   @db.Decimal(10, 2)
  motivo    String?
  validade  DateTime?

  criadoEm DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, servicoId])
  @@index([clienteId])
  @@index([servicoId])
}

model Pack {
  id            String   @id @default(cuid())
  clienteId     String
  // Opcional: um pack de massagens não está preso a um ritual — a cliente
  // escolhe Essência Plena, Puro Aroma ou Cera Quente em cada marcação (o
  // preço do pack é o mesmo seja qual for). servicoId fica null nesse caso;
  // só é preenchido nos packs de Drenagem, onde a duração (60/90 min) É o
  // serviço real do catálogo. Ver site/packs-massagens vs packs-drenagem.
  servicoId     String?
  totalSessoes  Int
  sessoesUsadas Int      @default(0)
  valorTotal    Decimal  @db.Decimal(10, 2)
  descricao     String?
  ativo         Boolean  @default(true)

  // Soma de PackPagamento.valor — mantido desnormalizado (recalculado a cada
  // registarPagamentoPack) para não ter de somar a lista toda em cada leitura
  // do perfil do cliente. "pendente" | "parcial" | "pago".
  valorPago       Decimal @default(0) @db.Decimal(10, 2)
  estadoPagamento String  @default("pendente")

  // Packs são individuais (não têm versão "a dois") — a receita é sempre
  // desta terapeuta, nunca dividida. null = Bea, mesma convenção de
  // Sessao.terapeutaId/GiftCard.terapeutaId.
  terapeutaId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente    Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico    Servico?        @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  terapeuta  User?           @relation("TerapeutaPack", fields: [terapeutaId], references: [id])
  pagamentos PackPagamento[]
  sessoes    Sessao[]

  @@index([clienteId])
  @@index([ativo])
  @@index([terapeutaId])
  @@index([servicoId])
}

// Um pack de 10 sessões pode ser pago em 2x (metade na 1.ª sessão, metade na
// 5.ª — regra do site, ver packs-massagens/packs-drenagem) — por isso é uma
// lista de pagamentos, não um único valorPago+estadoPagamento como a Sessao
// (que só tem uma cobrança). Pack.valorPago/estadoPagamento ficam
// desnormalizados a partir daqui.
model PackPagamento {
  id              String   @id @default(cuid())
  packId          String
  valor           Decimal  @db.Decimal(10, 2)
  metodoPagamento String?
  notas           String?
  criadoEm        DateTime @default(now())

  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
}

// ── Templates e Campanhas ────────────────────────────────────

model TemplateMensagem {
  id           String   @id @default(cuid())
  nome         String   @unique
  tipo         String
  texto        String
  variaveis    String[]
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  campanhas    Campanha[]

  @@index([tipo])
}

model Campanha {
  id           String         @id @default(cuid())
  nome         String
  segmento     Json
  templateId   String
  estado       EstadoCampanha @default(ativa)
  totalEnviado Int            @default(0)
  totalFalhado Int            @default(0)
  criadaEm     DateTime       @default(now())

  template     TemplateMensagem @relation(fields: [templateId], references: [id])
  mensagens    MensagemIA[]

  @@index([estado])
  @@index([criadaEm])
}

// ── Portal do Cliente ─────────────────────────────────────────

model PortalToken {
  id        String   @id @default(cuid())
  clienteId String   @unique
  token     String   @unique
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ── Gift Cards / Vouchers ─────────────────────────────────────

enum TipoVoucher {
  digital
  fisico
}

enum EstadoVoucher {
  ativo
  agendado
  usado
  expirado
  cancelado
}

model GiftCard {
  id                   String        @id @default(cuid())
  codigo               String        @unique

  tipo                 TipoVoucher   @default(digital)
  estado               EstadoVoucher @default(ativo)

  // Quem comprou
  compradorNome        String
  compradorTelefone    String?
  compradorEmail       String?

  // O que inclui
  servicoNome          String
  valorPago            Decimal       @db.Decimal(10, 2)

  // Para quem é (pode ser um nome diferente do comprador)
  beneficiarioNome     String?
  beneficiarioTelefone String?

  // Datas
  dataCompra           DateTime      @default(now())
  validade             DateTime?
  dataUso              DateTime?

  notas                String?

  // ── Campos que só existem para o voucher que a pessoa recebe ──
  // Quem oferece, tal como aparece impresso no voucher. Pode ser diferente
  // do compradorNome: às vezes é um grupo de amigas a oferecer, e o voucher
  // leva os nomes todos enquanto o registo/lead guarda só quem falou
  // connosco. Null = usar o compradorNome.
  nomesNoVoucher       String?
  // Mensagem pessoal mostrada no voucher ("Mereces este momento...").
  mensagemVoucher      String?

  // De quem é esta receita. Por omissão fica a null, que o financeiro lê
  // como "da Bea" — todo o voucher começa por ser dela. Reatribuído
  // automaticamente quando a sessão que o voucher paga passa a "realizada"
  // (ver lib/sessoes.ts): copia-se sempre quem a Bea respondeu em "quem vai
  // realizar a sessão?" — se for a Cristina, o valor passa para ela; se for
  // a dois, entra nas contas das duas (terapeuta2Id).
  terapeutaId          String?
  terapeuta2Id         String?

  // Quando resgatado, pode ligar ao cliente no CRM. Esta é a BENEFICIÁRIA
  // (quem marca e recebe a massagem), que pode não ser quem comprou.
  clienteId            String?
  // A lead criada para quem COMPROU o voucher. Separado do clienteId de
  // propósito: na maioria dos casos o voucher é um presente, e comprador e
  // beneficiária são pessoas diferentes.
  compradorClienteId   String?
  // A sessão específica que este voucher paga — sem isto não há como saber
  // qual das sessões da cliente é que, ao ficar "realizada", deve marcar
  // este voucher como usado (uma cliente pode ter várias sessões e vários
  // vouchers ao mesmo tempo).
  sessaoId             String?       @unique

  criadoEm             DateTime      @default(now())
  atualizadoEm         DateTime      @updatedAt

  cliente              Cliente?      @relation("BeneficiarioGiftCard", fields: [clienteId], references: [id])
  compradorCliente     Cliente?      @relation("CompradorGiftCard", fields: [compradorClienteId], references: [id])
  terapeuta            User?         @relation("TerapeutaGiftCard", fields: [terapeutaId], references: [id])
  terapeuta2           User?         @relation("Terapeuta2GiftCard", fields: [terapeuta2Id], references: [id])

  @@index([codigo])
  @@index([estado])
  @@index([tipo])
  @@index([dataCompra])
  @@index([sessaoId])
  @@index([terapeutaId])
  @@index([terapeuta2Id])
  @@index([compradorClienteId])
}

// ── Configurações do Negócio (singleton) ─────────────────────

model ConfiguracaoNegocio {
  id                   String   @id @default("singleton")

  nomeNegocio          String   @default("Essence Wellness")
  emailContacto        String   @default("geral@essencewellnesspt.com")
  whatsappPrincipal    String   @default("+351913308271")
  assinaturaAutomatica String   @default("Flora ✦ | Essence Wellness")
  assinaturaReferral   String   @default("Beatriz | Essence Wellness")
  horarioAbertura      String   @default("09:00")
  horarioFecho         String   @default("20:00")

  diasReativacao       Int      @default(45)
  quietHoraInicio      String   @default("21:00")
  quietHoraFim         String   @default("09:00")
  maxMensagensDia      Int      @default(10)

  atualizadoEm         DateTime @updatedAt
}

// ── Auditoria e segurança ─────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  quem       String   // email do utilizador, "api:n8n", ou "sistema"
  acao       String   // ex: "login.falhado", "cliente.atualizado", "mensagem.aprovada"
  entidade   String?  // "Cliente" | "Sessao" | "MensagemIA" | ...
  entidadeId String?
  detalhe    Json?
  ip         String?
  criadoEm   DateTime @default(now())

  @@index([acao, criadoEm])
  @@index([entidade, entidadeId])
  @@index([quem, criadoEm])
}

// ── Feedback de Clientes ──────────────────────────────────────

model Feedback {
  id                String   @id @default(cuid())
  clienteId         String
  sessaoId          String?
  rating            Int      // 1..5 — derivado de npsScore (ver lib/validations.ts mapearNpsParaRating)
  pontosPositivos   String?  // chips/tópicos do que gostou
  pontosMelhorar    String?  // texto privado quando negativo
  comentario        String?  // "o que precisarias sentir p/ voltar" (detrator) ou "o que faltou p/ ser 10" (passivo)
  encaminhadoGoogle Boolean  @default(false)
  // Recorrência — perguntado a promotoras e passivas (spec-010: npsScore >= 7).
  // quandoVoltar: chip único ("1_semana" | "2_semanas" | "1_mes" | "ainda_nao_sei").
  // interesseServico: chips múltiplos do catálogo, join(", ") — mesmo padrão de pontosPositivos.
  quandoVoltar      String?
  interesseServico  String?
  // Revisão neuromarketing/NPS (spec-010, 2026-07-31):
  npsScore              Int?     // 0-10, escala real capturada no forms — fonte de verdade, rating é derivado
  momentoPico           String?  // peak-end rule: chip único do momento de mais alívio
  motivoRegresso        String?  // self-generated commitment: frase da cliente sobre porque volta (só promotoras)
  faltaParaDez          String?  // follow-up clássico NPS para passivas: "o que faltou para ser um 10"
  pedidoContactoMarcacao Boolean @default(false) // implementation intention: pediu p/ a Bea tratar da marcação
  diaPreferido           String?  // chip único (dia da semana) — só quando pedidoContactoMarcacao=true
  horaPreferida          String?  // chip único (Manhã/Tarde/Fim de tarde) — idem
  criadoEm          DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  sessao  Sessao? @relation(fields: [sessaoId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([sessaoId])
}

// ── Tarefas / Follow-ups ──────────────────────────────────────

model Tarefa {
  id           String           @id @default(cuid())
  clienteId    String?
  titulo       String
  descricao    String?
  dataLimite   DateTime?
  estado       EstadoTarefa     @default(pendente)
  prioridade   PrioridadeTarefa @default(normal)
  tipo         TipoTarefa       @default(follow_up)
  criadoPor    String
  atribuidaA   String?
  resolvidaEm  DateTime?
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  cliente   Cliente? @relation(fields: [clienteId],  references: [id], onDelete: SetNull)
  criador   User     @relation("TarefaCriada",    fields: [criadoPor],  references: [id])
  atribuida User?    @relation("TarefaAtribuida", fields: [atribuidaA], references: [id])

  @@index([clienteId])
  @@index([estado])
  @@index([atribuidaA])
  @@index([dataLimite])
  @@index([criadoEm])
}
