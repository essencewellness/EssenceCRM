generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Autenticação (NextAuth) ───────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  username             String?   @unique
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 String    @default("terapeuta")
  precisaMudarPassword Boolean   @default(false)
  ativo                Boolean   @default(true)
  accounts             Account[]
  sessions             Session[]
  sessoesRealizadas    Sessao[]  @relation("TerapeutaSessao")
  clientesPrincipais   Cliente[] @relation("TerapeutaCliente")
  tarefasCriadas       Tarefa[]  @relation("TarefaCriada")
  tarefasAtribuidas    Tarefa[]  @relation("TarefaAtribuida")
  createdAt            DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Enums (integridade ao nível da base de dados) ─────────────

enum EstadoTarefa {
  pendente
  em_progresso
  concluida
  cancelada
}

enum PrioridadeTarefa {
  baixa
  normal
  alta
  urgente
}

enum TipoTarefa {
  follow_up
  ligacao
  mensagem
  nota
  outro
}

enum EstadoPagamento {
  pendente
  pago
  parcial
  isento
}

enum MetodoPagamento {
  dinheiro
  mbway
  transferencia
  voucher
}

enum EstadoCampanha {
  ativa
  cancelada
  concluida
}

enum TipoEtiqueta {
  saude
  campanha
  preferencia
  automatica
}

enum EstadoCliente {
  lead
  novo
  ativa_recente
  ativa_frequente
  vip_embaixadora
  vip_em_risco
  reativacao
  perdida
  blacklist
}

enum EstadoSessao {
  agendada
  confirmada
  aguarda_terapeuta
  realizada
  cancelada
  falta
}

enum EstadoMensagem {
  pendente
  aprovada
  em_fila
  enviada
  rejeitada
  falhada
}

enum Canal {
  whatsapp
  email
  sms
}

// ── CRM Principal ─────────────────────────────────────────────

model Cliente {
  id          String    @id @default(cuid())
  nome        String
  telefone    String?
  email       String?

  // Dados pessoais
  dataNascimento      DateTime?
  comoNosConheceu     String?   // instagram, referencia, google, calendly, etc.
  fonte               String    @default("calendly")

  // Estado CRM (9 estados)
  estado              EstadoCliente @default(novo)

  // Terapeuta responsável pelo cliente (atribuição mutável — base do isolamento por terapeuta)
  terapeutaPrincipalId String?
  terapeutaPrincipal   User?   @relation("TerapeutaCliente", fields: [terapeutaPrincipalId], references: [id], onDelete: SetNull)

  // Histórico clínico — DADOS DE SAÚDE (RGPD Art. 9: categoria especial)
  historicoAromasPreferidos     String?
  historicoCondicoesAlergias    String?
  historicoEstadoEmocional      String?   // deprecated: passa a ficar na Sessao
  historicoZonasTensao          String?   // deprecated: passa a ficar na Sessao
  historicoUltimaPausa          String?
  notasPessoais                 String?   // deprecated: passa a ficar na Sessao

  // Ficha clínica acumulativa gerada por IA (atualizada a cada onboarding)
  fichaClinica                  String?

  // Preferências de contacto
  canalPreferido      Canal     @default(whatsapp)
  temWhatsapp         Boolean   @default(true)
  aceitaMarketing     Boolean   @default(true)
  melhorDiaContacto   String?

  // RGPD — consentimentos com timestamp (prova de consentimento)
  consentimentoMarketingEm  DateTime?
  consentimentoSaudeEm      DateTime?   // consentimento explícito para dados clínicos
  anonimizadoEm             DateTime?   // preenchido quando exerce direito ao apagamento

  // Soft delete — nunca destruir histórico clínico por acidente
  apagadoEm           DateTime?

  // Métricas calculadas (actualizadas pelo motor de estados / sessões)
  ultimaSessao        DateTime?
  totalSessoes        Int       @default(0)
  totalGasto          Decimal   @default(0) @db.Decimal(10, 2)

  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  sessoes             Sessao[]
  etiquetas           ClienteEtiqueta[]
  mensagens           MensagemIA[]
  observacoes         Observacao[]
  precos              PrecoPersonalizado[]
  packs               Pack[]
  portalToken         PortalToken?
  giftCards           GiftCard[]
  tarefas             Tarefa[]
  feedbacks           Feedback[]

  @@index([estado])
  @@index([telefone])
  @@index([email])
  @@index([apagadoEm])
  @@index([terapeutaPrincipalId])
}

model Sessao {
  id          String    @id @default(cuid())
  clienteId   String

  data        DateTime
  hora        String?
  duracao     Int?      // duração em minutos
  servico     String?
  preco       Decimal?  @db.Decimal(10, 2)
  terapeuta   String    @default("bea")

  // Conteúdo clínico (preenchido pela Bea no form pós-sessão)
  aromaSessao         String?
  estadoEmocional     String?
  resumoSessao        String?
  notasPosSessao      String?
  linkDocumento       String?

  // Ficha de onboarding desta sessão (preenchida pela cliente antes da sessão)
  fichaEstadoEmocional    String?
  fichaZonasTensao        String?
  fichaFoco               String?
  fichaCondicoesAlergias  String?
  fichaAromasPreferidos   String?

  // Terapeuta que realizou a sessão
  terapeutaId  String?
  user         User?    @relation("TerapeutaSessao", fields: [terapeutaId], references: [id])

  estado              EstadoSessao @default(agendada)

  dataRecomendadaRegresso DateTime?

  // Rastreio de comunicações automáticas (escrito pelos Workflows N8N)
  briefingEnviado      Boolean   @default(false)
  lembreteEnviado      Boolean   @default(false)
  confirmacaoPresenca  Boolean?
  // Os 3 flags nutricao* rastreiam os 3 toques do fluxo de nutrição pré-sessão:
  // boas-vindas (+2d após marcação), meio do caminho (14d antes), reta final (7d antes)
  nutricaoBoasVindasEnviado Boolean @default(false)
  nutricao14dEnviado   Boolean   @default(false)
  nutricao7dEnviado    Boolean   @default(false)
  googleDocLink        String?
  // Lembrete à terapeuta para registar a sessão — enviado logo após o fim
  // do tratamento (data + hora + duração + 10 min), não num lote diário
  lembretePosSessaoEnviado Boolean @default(false)

  // Ficha de sessão para a terapeuta — relatório clínico estruturado (Groq), gerado 24h antes
  briefingJson         Json?

  // Catálogo de serviços (FK opcional — retrocompatível com sessões antigas)
  servicoId        String?
  // Idempotência Calendly — UUID único do evento, impede sessões duplicadas
  calendlyEventId  String? @unique

  // Pagamento
  estadoPagamento  EstadoPagamento  @default(pendente)
  valorPago        Decimal?         @db.Decimal(10, 2)
  metodoPagamento  MetodoPagamento?
  pagamentoEm      DateTime?

  // Avaliação pós-sessão
  avaliacaoNota         Int?
  avaliacaoComentario   String?
  avaliacaoEnviadaEm    DateTime?
  avaliacaoRespondidaEm DateTime?

  // Integrações
  calendarEventId  String?
  pdfUrl           String?
  calendlyEventUri String?
  // Links nativos do Calendly para remarcar/cancelar — usados na página pública
  // de confirmação em vez de reinventarmos essa lógica
  calendlyRescheduleUrl String?
  calendlyCancelUrl     String?

  apagadoEm   DateTime?
  criadoEm    DateTime  @default(now())

  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico_rel Servico?  @relation(fields: [servicoId], references: [id])
  feedbacks   Feedback[]

  @@index([data])
  @@index([clienteId])
  @@index([estado])
  @@index([servicoId])
  @@index([estadoPagamento])
  @@index([terapeutaId])
  @@index([calendlyEventUri])
}

model Etiqueta {
  id                 String            @id @default(cuid())
  nome               String            @unique
  cor                String            @default("#b9a07a")
  tipo               TipoEtiqueta      @default(campanha)
  bloqueiaAutomacoes Boolean           @default(false)
  clientes           ClienteEtiqueta[]

  @@index([tipo])
  @@index([bloqueiaAutomacoes])
}

model ClienteEtiqueta {
  clienteId  String
  etiquetaId String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([clienteId, etiquetaId])
}

model Observacao {
  id        String   @id @default(cuid())
  clienteId String
  texto     String
  autor     String   @default("bea")
  criadoEm DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model MensagemIA {
  id               String    @id @default(cuid())
  clienteId        String
  canal            Canal     @default(whatsapp)
  mensagemGerada   String
  mensagemFinal    String?
  estado           EstadoMensagem @default(pendente)
  // pendente → aprovada → em_fila → enviada | rejeitada | falhada
  motivoGeracao    String?
  converteu        Boolean?
  geradaEm         DateTime  @default(now())
  aprovadaEm       DateTime?
  enviadaEm        DateTime?

  // Fila de envio com espaçamento anti-spam (30–90s entre mensagens)
  enviarApos       DateTime?
  erroEnvio        String?

  // Tipo de mensagem e associação a campanha
  tipo             String    @default("reengagement")
  campanhaId       String?

  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  campanha         Campanha? @relation(fields: [campanhaId], references: [id])

  @@index([estado])
  @@index([clienteId])
  @@index([enviarApos])
  @@index([campanhaId])
}

// ── Catálogo de Serviços ──────────────────────────────────────

model Servico {
  id             String   @id @default(cuid())
  nome           String   @unique
  descricao      String?
  duracaoMinutos Int      @default(60)
  precoBase      Decimal  @db.Decimal(10, 2)
  ativo          Boolean  @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessoes Sessao[]
  precos  PrecoPersonalizado[]
  packs   Pack[]

  @@index([ativo])
}

model PrecoPersonalizado {
  id        String    @id @default(cuid())
  clienteId String
  servicoId String
  valor     Decimal   @db.Decimal(10, 2)
  motivo    String?
  validade  DateTime?

  criadoEm DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, servicoId])
  @@index([clienteId])
}

model Pack {
  id            String   @id @default(cuid())
  clienteId     String
  servicoId     String
  totalSessoes  Int
  sessoesUsadas Int      @default(0)
  valorTotal    Decimal  @db.Decimal(10, 2)
  descricao     String?
  ativo         Boolean  @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([ativo])
}

// ── Templates e Campanhas ────────────────────────────────────

model TemplateMensagem {
  id           String   @id @default(cuid())
  nome         String   @unique
  tipo         String
  texto        String
  variaveis    String[]
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  campanhas    Campanha[]

  @@index([tipo])
}

model Campanha {
  id           String         @id @default(cuid())
  nome         String
  segmento     Json
  templateId   String
  estado       EstadoCampanha @default(ativa)
  totalEnviado Int            @default(0)
  totalFalhado Int            @default(0)
  criadaEm     DateTime       @default(now())

  template     TemplateMensagem @relation(fields: [templateId], references: [id])
  mensagens    MensagemIA[]

  @@index([estado])
  @@index([criadaEm])
}

// ── Portal do Cliente ─────────────────────────────────────────

model PortalToken {
  id        String   @id @default(cuid())
  clienteId String   @unique
  token     String   @unique
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ── Gift Cards / Vouchers ─────────────────────────────────────

enum TipoVoucher {
  digital
  fisico
}

enum EstadoVoucher {
  ativo
  usado
  expirado
  cancelado
}

model GiftCard {
  id                   String        @id @default(cuid())
  codigo               String        @unique

  tipo                 TipoVoucher   @default(digital)
  estado               EstadoVoucher @default(ativo)

  // Quem comprou
  compradorNome        String
  compradorTelefone    String?
  compradorEmail       String?

  // O que inclui
  servicoNome          String
  valorPago            Decimal       @db.Decimal(10, 2)

  // Para quem é (pode ser um nome diferente do comprador)
  beneficiarioNome     String?
  beneficiarioTelefone String?

  // Datas
  dataCompra           DateTime      @default(now())
  validade             DateTime?
  dataUso              DateTime?

  notas                String?

  // Quando resgatado, pode ligar ao cliente no CRM
  clienteId            String?

  criadoEm             DateTime      @default(now())
  atualizadoEm         DateTime      @updatedAt

  cliente              Cliente?      @relation(fields: [clienteId], references: [id])

  @@index([codigo])
  @@index([estado])
  @@index([tipo])
  @@index([dataCompra])
}

// ── Configurações do Negócio (singleton) ─────────────────────

model ConfiguracaoNegocio {
  id                   String   @id @default("singleton")

  nomeNegocio          String   @default("Essence Wellness")
  emailContacto        String   @default("geral@essencewellnesspt.com")
  whatsappPrincipal    String   @default("+351913308271")
  assinaturaAutomatica String   @default("Flora ✦ | Essence Wellness")
  assinaturaReferral   String   @default("Beatriz | Essence Wellness")
  horarioAbertura      String   @default("09:00")
  horarioFecho         String   @default("20:00")

  diasReativacao       Int      @default(45)
  quietHoraInicio      String   @default("21:00")
  quietHoraFim         String   @default("09:00")
  maxMensagensDia      Int      @default(10)

  atualizadoEm         DateTime @updatedAt
}

// ── Auditoria e segurança ─────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  quem       String   // email do utilizador, "api:n8n", ou "sistema"
  acao       String   // ex: "login.falhado", "cliente.atualizado", "mensagem.aprovada"
  entidade   String?  // "Cliente" | "Sessao" | "MensagemIA" | ...
  entidadeId String?
  detalhe    Json?
  ip         String?
  criadoEm   DateTime @default(now())

  @@index([acao, criadoEm])
  @@index([entidade, entidadeId])
  @@index([quem, criadoEm])
}

// ── Feedback de Clientes ──────────────────────────────────────

model Feedback {
  id                String   @id @default(cuid())
  clienteId         String
  sessaoId          String?
  rating            Int      // 1..5
  pontosPositivos   String?  // chips/tópicos do que gostou
  pontosMelhorar    String?  // texto privado quando negativo
  comentario        String?
  encaminhadoGoogle Boolean  @default(false)
  criadoEm          DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  sessao  Sessao? @relation(fields: [sessaoId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([sessaoId])
}

// ── Tarefas / Follow-ups ──────────────────────────────────────

model Tarefa {
  id           String           @id @default(cuid())
  clienteId    String?
  titulo       String
  descricao    String?
  dataLimite   DateTime?
  estado       EstadoTarefa     @default(pendente)
  prioridade   PrioridadeTarefa @default(normal)
  tipo         TipoTarefa       @default(follow_up)
  criadoPor    String
  atribuidaA   String?
  resolvidaEm  DateTime?
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  cliente   Cliente? @relation(fields: [clienteId],  references: [id], onDelete: SetNull)
  criador   User     @relation("TarefaCriada",    fields: [criadoPor],  references: [id])
  atribuida User?    @relation("TarefaAtribuida", fields: [atribuidaA], references: [id])

  @@index([clienteId])
  @@index([estado])
  @@index([atribuidaA])
  @@index([dataLimite])
  @@index([criadoEm])
}
